{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPU: Run Current Python File",
      "type": "shell",
      "command": "infra/brev/scripts/compose",
      "args": [
        "exec",
        "-T",
        "jupyter",
        "python",
        "/workspace/${relativeFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: CUDA and PyTorch Check",
      "type": "shell",
      "command": "infra/brev/scripts/compose",
      "args": [
        "exec",
        "-T",
        "jupyter",
        "python",
        "-c",
        "import torch; assert torch.cuda.is_available(); print(\"GPU:\", torch.cuda.get_device_name(0)); print(\"PyTorch:\", torch.__version__); print(\"CUDA:\", torch.version.cuda)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: Build and Run Current Standalone CUDA File",
      "type": "shell",
      "command": "infra/brev/scripts/run-gpu",
      "args": [
        "${relativeFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: Open Runtime Shell",
      "type": "shell",
      "command": "infra/brev/scripts/compose",
      "args": [
        "exec",
        "jupyter",
        "bash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
